{
  "dashboard": {
    "title": "Chaos Operator - Overview",
    "tags": ["chaos", "kubernetes", "operator"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Active Experiments",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_active)", "refId": "A"}],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"value": null, "color": "green"},
              {"value": 5, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]}
          }
        }
      },
      {
        "id": 2,
        "title": "Total Experiments Created",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_total)", "refId": "A"}],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"value": null, "color": "blue"}
            ]}
          }
        }
      },
      {
        "id": 3,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_status_total{status=\"Completed\"}) / sum(chaos_experiments_status_total) * 100", "refId": "A"}],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"value": null, "color": "red"},
              {"value": 70, "color": "yellow"},
              {"value": 90, "color": "green"}
            ]}
          }
        }
      },
      {
        "id": 4,
        "title": "Error Rate (5m)",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "sum(rate(chaos_execution_errors_total[5m]))", "refId": "A"}],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"value": null, "color": "green"},
              {"value": 0.1, "color": "yellow"},
              {"value": 1, "color": "red"}
            ]}
          }
        }
      },
      {
        "id": 5,
        "title": "Experiments by Type",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 4, "w": 8, "h": 8},
        "targets": [
          {"expr": "sum(chaos_experiments_total) by (type)", "legendFormat": "{{type}}", "refId": "A"}
        ]
      },
      {
        "id": 6,
        "title": "Active Experiments by Type & Phase",
        "type": "bargauge",
        "gridPos": {"x": 8, "y": 4, "w": 8, "h": 8},
        "targets": [
          {"expr": "chaos_experiments_active", "legendFormat": "{{type}} - {{phase}}", "refId": "A"}
        ]
      },
      {
        "id": 7,
        "title": "Targets Affected Over Time",
        "type": "timeseries",
        "gridPos": {"x": 16, "y": 4, "w": 8, "h": 8},
        "targets": [
          {"expr": "sum(rate(chaos_targets_affected_total[5m])) by (type)", "legendFormat": "{{type}}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "ops"}
        }
      },
      {
        "id": 8,
        "title": "PodChaos Experiments",
        "type": "stat",
        "gridPos": {"x": 0, "y": 12, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_total{type=\"PodChaos\"})", "refId": "A"}],
        "fieldConfig": {"defaults": {"color": {"fixedColor": "blue", "mode": "fixed"}}}
      },
      {
        "id": 9,
        "title": "NetworkChaos Experiments",
        "type": "stat",
        "gridPos": {"x": 6, "y": 12, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_total{type=\"NetworkChaos\"})", "refId": "A"}],
        "fieldConfig": {"defaults": {"color": {"fixedColor": "orange", "mode": "fixed"}}}
      },
      {
        "id": 10,
        "title": "StressChaos Experiments",
        "type": "stat",
        "gridPos": {"x": 12, "y": 12, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_total{type=\"StressChaos\"})", "refId": "A"}],
        "fieldConfig": {"defaults": {"color": {"fixedColor": "purple", "mode": "fixed"}}}
      },
      {
        "id": 11,
        "title": "HTTPChaos Experiments",
        "type": "stat",
        "gridPos": {"x": 18, "y": 12, "w": 6, "h": 4},
        "targets": [{"expr": "sum(chaos_experiments_total{type=\"HTTPChaos\"})", "refId": "A"}],
        "fieldConfig": {"defaults": {"color": {"fixedColor": "green", "mode": "fixed"}}}
      },
      {
        "id": 12,
        "title": "Experiment Duration Distribution",
        "type": "histogram",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "chaos_experiments_duration_seconds_bucket", "legendFormat": "{{type}} - {{action}}", "refId": "A", "format": "heatmap"}
        ]
      },
      {
        "id": 13,
        "title": "Reconciliation Duration (p99)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.99, sum(rate(chaos_reconciliation_duration_seconds_bucket[5m])) by (le, type))", "legendFormat": "{{type}} p99", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"}
        }
      },
      {
        "id": 14,
        "title": "Blast Radius Limits Hit",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
        "targets": [
          {"expr": "sum(rate(chaos_blast_radius_limit_total[5m])) by (type)", "legendFormat": "{{type}}", "refId": "A"}
        ]
      },
      {
        "id": 15,
        "title": "Execution Errors by Type",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
        "targets": [
          {"expr": "sum(rate(chaos_execution_errors_total[5m])) by (type, error_type)", "legendFormat": "{{type}} - {{error_type}}", "refId": "A"}
        ]
      },
      {
        "id": 16,
        "title": "Experiment Status Distribution",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8},
        "targets": [
          {"expr": "sum(chaos_experiments_status_total) by (status)", "legendFormat": "{{status}}", "refId": "A"}
        ]
      },
      {
        "id": 17,
        "title": "Average Experiment Duration by Type",
        "type": "bargauge",
        "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8},
        "targets": [
          {"expr": "chaos_experiments_duration_seconds_sum / chaos_experiments_duration_seconds_count", "legendFormat": "{{type}} - {{action}}", "refId": "A"}
        ],
        "fieldConfig": {
          "defaults": {"unit": "s"}
        }
      }
    ]
  }
}
